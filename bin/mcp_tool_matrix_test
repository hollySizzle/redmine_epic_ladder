  ids = result.fetch('user_stories').map { |story| story.fetch('id') }
  assert!('created user story should be listed') { ids.include?(user_story_id.to_s) }
  record('list_user_stories_tool', :normal)
end

step('get_project_structure_tool normal with max_depth 4') do
  result = call_tool(
    endpoint,
    api_key,
    bearer_token,
    'get_project_structure_tool',
    project_id: project_id,
    max_depth: 4,
    include_closed: true
  )
  assert!('project structure should include created epic') do
    result.fetch('structure').any? { |epic| epic.fetch('id') == epic_id.to_s }
  end
  record('get_project_structure_tool', :normal)
end

step('get_issue_detail_tool normal with children/journals/relations') do
  result = detail(endpoint, api_key, bearer_token, user_story_id, %w[children journals relations])
  assert!('detail should include created children') { result.fetch('children_count') >= 3 }
  record('get_issue_detail_tool', :normal)
end

step('list_recently_updated_issues_tool normal') do
  result = call_tool(endpoint, api_key, bearer_token, 'list_recently_updated_issues_tool', project_id: project_id, limit: 10)
  assert!('recent issues should include created data') do
    result.fetch('issues').any? { |issue| @created_issue_ids.include?(issue.fetch('id')) }
  end
  record('list_recently_updated_issues_tool', :normal)
end

step('add_issue_comment_tool normal') do
  call_tool(endpoint, api_key, bearer_token, 'add_issue_comment_tool', issue_id: user_story_id, comment: "MCP matrix test comment #{stamp}")
  record('add_issue_comment_tool', :normal)
end

step('update issue scalar fields normal') do
  call_tool(endpoint, api_key, bearer_token, 'update_issue_subject_tool', issue_id: user_story_id, subject: "[MCP MATRIX TEST #{stamp}] UserStory updated")
  record('update_issue_subject_tool', :normal)
  call_tool(endpoint, api_key, bearer_token, 'update_issue_description_tool', issue_id: user_story_id, description: "Updated by matrix test #{stamp}")
  record('update_issue_description_tool', :normal)
  call_tool(endpoint, api_key, bearer_token, 'update_issue_progress_tool', issue_id: task_id, progress: 40)
  record('update_issue_progress_tool', :normal)
  call_tool(endpoint, api_key, bearer_token, 'update_issue_assignee_tool', issue_id: user_story_id, assigned_to_id: assignee_id)
  record('update_issue_assignee_tool', :normal)
end

step('assign_to_version_tool normal') do
  call_tool(endpoint, api_key, bearer_token, 'assign_to_version_tool', issue_id: user_story_id, version_id: version1_id, propagate_to_children: true)
  record('assign_to_version_tool', :normal)
end

step('move_to_next_version_tool normal') do
  result = call_tool(endpoint, api_key, bearer_token, 'move_to_next_version_tool', issue_id: user_story_id, confirmed: true)
  assert!('move_to_next_version should move away from V1') { result.dig('old_version', 'id') == version1_id.to_s }
  assert!('move_to_next_version should select a different next version') { result.dig('new_version', 'id') != version1_id.to_s }
  record('move_to_next_version_tool', :normal)
end

step('update_issue_status_tool normal') do
  call_tool(endpoint, api_key, bearer_token, 'update_issue_status_tool', issue_id: user_story_id, status_name: '進行中', confirmed: true)
  record('update_issue_status_tool', :normal)
end

step('bulk_update_issue_status_tool normal with partial failure') do
  result = call_tool(
    endpoint,
    api_key,
    bearer_token,
    'bulk_update_issue_status_tool',
    issue_ids: [task_id, bug_id, test_id, '999999999'],
    status_name: '進行中',
    comment: "MCP matrix test bulk #{stamp}"
  )
  assert!('bulk should have three successes') { result.fetch('succeeded') == 3 }
  assert!('bulk should have one failure') { result.fetch('failed') == 1 }
  record('bulk_update_issue_status_tool', :normal)
  record('bulk_update_issue_status_tool', :negative)
end

relation_id = step('add_related_issue_tool normal') do
  result = call_tool(endpoint, api_key, bearer_token, 'add_related_issue_tool', issue_id: bug_id, related_issue_id: task_id, relation_type: 'blocks')
  id = result.fetch('relation_id')
  record('add_related_issue_tool', :normal)
  id
end

step('remove_related_issue_tool normal') do
  result = detail(endpoint, api_key, bearer_token, bug_id, %w[relations])
  assert!('relation should be visible before removal') do
    result.fetch('relations').any? { |relation| relation.fetch('id') == relation_id.to_s }
  end
  call_tool(endpoint, api_key, bearer_token, 'remove_related_issue_tool', issue_id: bug_id, related_issue_id: task_id)
  record('remove_related_issue_tool', :normal)
end

copy_id = step('copy_issue_tool normal') do
  result = call_tool(
    endpoint,
    api_key,
    bearer_token,
    'copy_issue_tool',
    source_issue_id: task_id,
    subject: "[MCP MATRIX TEST #{stamp}] Copied Task",
    parent_issue_id: user_story_id,
    version_id: version3_id
  )
  id = result.fetch('issue_id')
  @created_issue_ids << id
  record('copy_issue_tool', :normal)
  id
end

step('update_issue_parent_tool normal remove and restore') do
  call_tool(endpoint, api_key, bearer_token, 'update_issue_parent_tool', issue_id: copy_id, parent_issue_id: 'null')
  call_tool(endpoint, api_key, bearer_token, 'update_issue_parent_tool', issue_id: copy_id, parent_issue_id: user_story_id, inherit_version_and_dates: true)
  record('update_issue_parent_tool', :normal)
end

promoted_us_id = step('promote_to_us_tool normal') do
  result = call_tool(
    endpoint,
    api_key,
    bearer_token,
    'promote_to_us_tool',
    issue_id: bug_id,
    target_feature_id: feature_id,
    us_subject: "[MCP MATRIX TEST #{stamp}] Promoted Bug US"
  )
  id = result.dig('new_user_story', 'id')
  raise "promote_to_us_tool missing new_user_story id: #{result}" unless id
  @created_issue_ids << id
  record('promote_to_us_tool', :normal)
  id
end

step('update_custom_fields_tool normal') do
  call_tool(
    endpoint,
    api_key,
    bearer_token,
    'update_custom_fields_tool',
    issue_id: task_id,
    custom_fields: { 'MCP Sandbox Text' => "matrix #{stamp}" }
  )
  record('update_custom_fields_tool', :normal)
end

step('update_custom_fields_tool negative no matching field') do
  expect_failure(
    endpoint,
    api_key,
    bearer_token,
    'update_custom_fields_tool',
    {
      issue_id: promoted_us_id,
      custom_fields: { "MCP Matrix Missing Field #{stamp}" => 'value' }
    },
    'カスタムフィールド'
  )
  record('update_custom_fields_tool', :negative)
end

step('representative negative cases') do
  expect_failure(endpoint, api_key, bearer_token, 'get_issue_detail_tool', { issue_id: '999999999' }, 'チケットが見つかりません')
  record('get_issue_detail_tool', :negative)
  expect_failure(endpoint, api_key, bearer_token, 'update_issue_progress_tool', { issue_id: user_story_id, progress: 40 }, '子チケットから自動計算')
  record('update_issue_progress_tool', :negative)
  expect_failure(endpoint, api_key, bearer_token, 'list_versions_tool', { project_id: 'missing-project-for-matrix' }, 'プロジェクトが見つかりません')
  record('list_versions_tool', :negative)
  expect_failure(endpoint, api_key, bearer_token, 'add_related_issue_tool', { issue_id: task_id, related_issue_id: test_id, relation_type: 'not_a_relation' }, '無効な関連タイプ')
  record('add_related_issue_tool', :negative)
  expect_failure(endpoint, api_key, bearer_token, 'update_issue_parent_tool', { issue_id: epic_id, parent_issue_id: task_id }, '循環参照')
  record('update_issue_parent_tool', :negative)
end

uncovered = EXPECTED_TOOLS.reject { |tool| @coverage.fetch(tool, []).any? { |kind| kind == :normal || kind == :negative } }
raise "tools with schema only and no behavior coverage: #{uncovered.join(', ')}" unless uncovered.empty?

puts
puts 'MCP tool matrix test passed.'
puts "Tool count: #{EXPECTED_TOOLS.size}"
puts "Created issue IDs: #{@created_issue_ids.join(', ')}"
puts "Created version IDs: #{@created_version_ids.join(', ')}"
puts 'Coverage:'
EXPECTED_TOOLS.each do |tool|
  puts "  #{tool}: #{@coverage.fetch(tool, []).uniq.join(', ')}"
end
