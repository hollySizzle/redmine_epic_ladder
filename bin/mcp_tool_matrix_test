  result = call_tool(endpoint, api_key, bearer_token, 'list_epics_tool', project_id: project_id, status: 'open')
  assert!('created epic should be listed') { result.fetch('epics').any? { |epic| epic.fetch('id') == epic_id.to_s } }
  record('list_epics_tool', :normal)
end

