  result = call_tool(
    endpoint,
    api_key,
    bearer_token,
    'create_user_story_tool',
    project_id: project_id,
    parent_feature_id: feature_id,
    subject: "[MCP MATRIX TEST #{stamp}] UserStory",
    description: "MCP matrix test user story",
    version_id: version1_id
  )
  id = result.fetch('user_story_id')
  @created_issue_ids << id
  record('create_user_story_tool', :normal)
  id
end

