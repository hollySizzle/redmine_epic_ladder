    project_id: project_id,
    subject: "[MCP MATRIX TEST #{stamp}] Epic",
    description: "MCP matrix test epic"
  )
  id = result.fetch('epic_id')
  @created_issue_ids << id
  record('create_epic_tool', :normal)
  id
end

