#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'net/http'
require 'uri'

base_url = ARGV[0] || ENV.fetch('MCP_BASE_URL', 'http://localhost:8500')
endpoint = URI.join(base_url, '/mcp/rpc')
api_key = ENV['MCP_API_KEY']
bearer_token = ENV['MCP_BEARER_TOKEN']

if api_key.to_s.empty? && bearer_token.to_s.empty?
  warn 'Set MCP_API_KEY or MCP_BEARER_TOKEN.'
  exit 1
end

EXPECTED_TOOLS = %w[
  add_issue_comment_tool
  add_related_issue_tool
  assign_to_version_tool
  bulk_update_issue_status_tool
  copy_issue_tool
  create_bug_tool
  create_epic_tool
  create_feature_tool
  create_inquiry_tool
  create_task_tool
  create_test_tool
  create_user_story_tool
  create_version_tool
  get_issue_detail_tool
  get_project_structure_tool
  list_epics_tool
  list_project_members_tool
  list_recently_updated_issues_tool
  list_statuses_tool
  list_user_stories_tool
  list_versions_tool
  move_to_next_version_tool
  promote_to_us_tool
  remove_related_issue_tool
  update_custom_fields_tool
  update_issue_assignee_tool
  update_issue_description_tool
  update_issue_parent_tool
  update_issue_progress_tool
  update_issue_status_tool
  update_issue_subject_tool
].freeze

@request_id = 0
@created_issue_ids = []
@created_version_ids = []
@coverage = {}

def rpc(endpoint, api_key, bearer_token, method, params = {})
  @request_id += 1
  request = Net::HTTP::Post.new(endpoint)
  request['Content-Type'] = 'application/json'
  request['X-Redmine-API-Key'] = api_key if api_key && !api_key.empty?
  request['Authorization'] = "Bearer #{bearer_token}" if bearer_token && !bearer_token.empty?
  request.body = JSON.generate(jsonrpc: '2.0', id: @request_id, method: method, params: params)

  response = Net::HTTP.start(endpoint.host, endpoint.port, use_ssl: endpoint.scheme == 'https') do |http|
    http.request(request)
  end

  raise "#{method}: HTTP #{response.code} #{response.body}" unless response.is_a?(Net::HTTPSuccess)

  JSON.parse(response.body)
end

def parse_tool_result(outer, label)
  raise "#{label}: JSON-RPC error #{outer.fetch('error')}" if outer['error']

  text = outer.dig('result', 'content', 0, 'text')
  raise "#{label}: missing text content #{outer}" unless text

  JSON.parse(text)
end

def call_tool(endpoint, api_key, bearer_token, name, arguments)
  outer = rpc(endpoint, api_key, bearer_token, 'tools/call', { name: name, arguments: arguments })
  result = parse_tool_result(outer, name)
  raise "#{name}: #{result}" unless result['success']

  result
end

def expect_failure(endpoint, api_key, bearer_token, name, arguments, error_hint = nil)
  outer = rpc(endpoint, api_key, bearer_token, 'tools/call', { name: name, arguments: arguments })
  result = parse_tool_result(outer, name)
  raise "#{name}: expected failure but succeeded #{result}" if result['success']

  if error_hint && !result.fetch('error', '').include?(error_hint)
    raise "#{name}: expected error to include #{error_hint.inspect}, got #{result}"
  end

  result
end

def step(label)
  print "#{label} ... "
  result = yield
  puts 'OK'
  result
rescue StandardError => e
  puts 'NG'
  warn e.message
  exit 1
end

def record(tool_name, kind)
  @coverage[tool_name] ||= []
  @coverage[tool_name] << kind
end

def assert!(message)
  raise message unless yield
end

def detail(endpoint, api_key, bearer_token, issue_id, include_sections = [])
  call_tool(
    endpoint,
    api_key,
    bearer_token,
    'get_issue_detail_tool',
    issue_id: issue_id,
    include: include_sections
  )
end

def create_version(endpoint, api_key, bearer_token, project_id, stamp, label, date)
  result = call_tool(
    endpoint,
    api_key,
    bearer_token,
    'create_version_tool',
    project_id: project_id,
    name: "[MCP MATRIX TEST #{stamp}] #{label}",
    effective_date: date,
    description: "MCP matrix test version #{label}"
  )
  version_id = result.fetch('version_id')
  @created_version_ids << version_id
  record('create_version_tool', :normal)
  version_id
end

stamp = Time.now.utc.strftime('%Y%m%d%H%M%S')
project_id = ENV.fetch('MCP_TEST_PROJECT', 'ai-recommend')

puts "MCP tool matrix test: #{endpoint}"
puts "Project: #{project_id}"

tools = step('tools/list exposes expected tool schemas') do
  outer = rpc(endpoint, api_key, bearer_token, 'tools/list')
  raise "tools/list: #{outer.fetch('error')}" if outer['error']

  listed = outer.dig('result', 'tools')
  raise "tools/list did not return tools: #{outer}" unless listed.is_a?(Array)

  names = listed.map { |tool| tool.fetch('name') }.sort
  missing = EXPECTED_TOOLS - names
  extra = names - EXPECTED_TOOLS
  assert!("missing tools: #{missing.join(', ')}") { missing.empty? }
  assert!("unexpected tools: #{extra.join(', ')}") { extra.empty? }

  listed.each do |tool|
    assert!("tool #{tool['name']} missing description") { tool['description'].to_s.strip != '' }
    assert!("tool #{tool['name']} missing inputSchema") { tool['inputSchema'].is_a?(Hash) }
  end
  names
end
tools.each { |name| record(name, :schema) }

members = step('list_project_members_tool normal') do
  result = call_tool(endpoint, api_key, bearer_token, 'list_project_members_tool', project_id: project_id, limit: 10)
  assert!('members should not be empty') { result.fetch('members').any? }
  record('list_project_members_tool', :normal)
  result
end
assignee_id = members.fetch('members').first.fetch('user_id')

step('list_statuses_tool normal') do
  result = call_tool(endpoint, api_key, bearer_token, 'list_statuses_tool', project_id: project_id)
  assert!('statuses should include 進行中') { result.fetch('statuses').any? { |status| status['name'] == '進行中' } }
  record('list_statuses_tool', :normal)
end

version1_id = step('create version 1') do
  create_version(endpoint, api_key, bearer_token, project_id, stamp, 'V1', '2026-10-31')
end
version2_id = step('create version 2') do
  create_version(endpoint, api_key, bearer_token, project_id, stamp, 'V2', '2026-11-30')
end
version3_id = step('create version 3') do
  create_version(endpoint, api_key, bearer_token, project_id, stamp, 'V3', '2026-12-31')
end

step('list_versions_tool normal') do
  result = call_tool(endpoint, api_key, bearer_token, 'list_versions_tool', project_id: project_id, status: 'open')
  ids = result.fetch('versions').map { |version| version.fetch('id') }
  assert!('new versions not listed') { [version1_id, version2_id, version3_id].all? { |id| ids.include?(id.to_s) } }
  record('list_versions_tool', :normal)
end

