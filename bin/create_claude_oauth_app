#!/bin/bash

set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REDMINE_ROOT="$(cd "$PLUGIN_DIR/../.." && pwd)"

APP_NAME="${CLAUDE_MCP_APP_NAME:-Claude Web MCP}"
REDIRECT_URI="${CLAUDE_MCP_REDIRECT_URI:-https://claude.ai/api/mcp/auth_callback}"
SCOPES="${CLAUDE_MCP_SCOPES:-view_project view_issues add_issues edit_issues add_issue_notes manage_versions manage_issue_relations add_subprojects}"
RAILS_ENV_NAME="${RAILS_ENV:-development}"

cd "$REDMINE_ROOT"

RAILS_ENV="$RAILS_ENV_NAME" \
CLAUDE_MCP_APP_NAME="$APP_NAME" \
CLAUDE_MCP_REDIRECT_URI="$REDIRECT_URI" \
CLAUDE_MCP_SCOPES="$SCOPES" \
bundle exec rails runner - <<'RUBY'
Setting.rest_api_enabled = '1'

app = Doorkeeper::Application.find_by(name: ENV.fetch('CLAUDE_MCP_APP_NAME'))

if app
  expected_scopes = ENV.fetch('CLAUDE_MCP_SCOPES')
  expected_redirect_uri = ENV.fetch('CLAUDE_MCP_REDIRECT_URI')
  expected_scope_list = expected_scopes.split.sort
  actual_scope_list = app.scopes.to_s.split.sort
  updated = false

  if app.redirect_uri != expected_redirect_uri ||
     actual_scope_list != expected_scope_list ||
     !app.confidential?
    app.update!(
      redirect_uri: expected_redirect_uri,
      scopes: expected_scopes,
      confidential: true
    )
    updated = true
  end

  puts "Redmine OAuth application for Claude Web MCP already exists"
  puts updated ? "Updated existing application settings in place" : "Existing application settings already match"
  puts
  puts "Name: #{app.name}"
  puts "Redirect URI: #{app.redirect_uri}"
  puts "Scopes: #{app.scopes}"
  puts
  puts "Use these values in Claude Web Custom Connector advanced settings:"
  puts "OAuth Client ID: #{app.uid}"
  puts "OAuth Client Secret: unavailable (Redmine hashes application secrets; recreate the application to view a new secret)"
  exit
end

app = Doorkeeper::Application.create!(
  name: ENV.fetch('CLAUDE_MCP_APP_NAME'),
  redirect_uri: ENV.fetch('CLAUDE_MCP_REDIRECT_URI'),
  scopes: ENV.fetch('CLAUDE_MCP_SCOPES'),
  confidential: true
)

puts "Created Redmine OAuth application for Claude Web MCP"
puts
puts "Name: #{app.name}"
puts "Redirect URI: #{app.redirect_uri}"
puts "Scopes: #{app.scopes}"
puts
puts "Use these values in Claude Web Custom Connector advanced settings:"
puts "OAuth Client ID: #{app.uid}"
puts "OAuth Client Secret: #{app.plaintext_secret}"
puts
puts "Secret is only available at creation time because Redmine hashes application secrets."
RUBY
